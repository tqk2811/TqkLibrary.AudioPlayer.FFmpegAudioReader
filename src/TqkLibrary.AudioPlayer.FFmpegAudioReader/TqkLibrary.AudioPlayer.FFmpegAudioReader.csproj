<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\ProjectBuildProperties.targets" />

	<PropertyGroup>
		<TargetFrameworks>net462;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>11.0</LangVersion>
		<Nullable>enable</Nullable>
		<!-- Where the CMake-built native wrapper (per-RID) is collected.
		     Build.ps1 / CI populates: $(NativeArtifactsDir)\runtimes\<rid>\native\<wrapper> -->
		<NativeArtifactsDir Condition="'$(NativeArtifactsDir)' == ''">$(MSBuildProjectDirectory)\..\native-artifacts</NativeArtifactsDir>
	</PropertyGroup>

	<!-- FFmpeg 9.0 native libraries, one package per RID. Their runtimes/<rid>/native
	     assets flow transitively to the consuming app, which loads only its own RID. -->
	<ItemGroup>
		<PackageReference Include="TqkLibrary.FFmpeg.Lgpl2.Native.Win.x86" Version="9.0.2" />
		<PackageReference Include="TqkLibrary.FFmpeg.Lgpl2.Native.Win.x64" Version="9.0.2" />
		<PackageReference Include="TqkLibrary.FFmpeg.Lgpl2.Native.Win.arm64" Version="9.0.2" />
		<PackageReference Include="TqkLibrary.FFmpeg.Lgpl2.Native.Linux.x64" Version="9.0.2" />
		<PackageReference Include="TqkLibrary.FFmpeg.Lgpl2.Native.Linux.arm64" Version="9.0.2" />
	</ItemGroup>

	<!-- Ship the native wrapper under runtimes/<rid>/native so it is laid out next
	     to the FFmpeg libs and the managed resolver can find it. Content so it also
	     flows to projects that reference this one (e.g. ConsoleTest). -->
	<ItemGroup Condition="Exists('$(NativeArtifactsDir)\runtimes')">
		<Content Include="$(NativeArtifactsDir)\runtimes\**\*.*">
			<Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
			<Pack>false</Pack>
		</Content>
	</ItemGroup>

</Project>
