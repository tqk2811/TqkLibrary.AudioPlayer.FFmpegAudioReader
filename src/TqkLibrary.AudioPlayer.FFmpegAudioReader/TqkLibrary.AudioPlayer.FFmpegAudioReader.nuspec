<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
	<!--https://docs.microsoft.com/en-us/nuget/reference/nuspec-->
	<metadata>
		<id>TqkLibrary.AudioPlayer.FFmpegAudioReader</id>
		<version>$version$</version>
		<description>FFmpeg Audio Frame Reader (cross-platform: Windows x86/x64/arm64, Linux x64/arm64)</description>
		<authors>tqk2811</authors>
		<projectUrl>https://github.com/tqk2811/TqkLibrary.AudioPlayer.FFmpegAudioReader</projectUrl>
		<repository type="git" url="https://github.com/tqk2811/TqkLibrary.AudioPlayer.FFmpegAudioReader.git"/>
		<license type="expression">MIT</license>
		<readme>docs\README.md</readme>
		<dependencies>
			<group targetFramework="net462">
				<dependency id="TqkLibrary.FFmpeg.Gpl2.Native.Win.x86" version="9.0.2" />
				<dependency id="TqkLibrary.FFmpeg.Gpl2.Native.Win.x64" version="9.0.2" />
				<dependency id="TqkLibrary.FFmpeg.Gpl2.Native.Win.arm64" version="9.0.2" />
			</group>
			<group targetFramework="net8.0">
				<dependency id="TqkLibrary.FFmpeg.Gpl2.Native.Win.x86" version="9.0.2" />
				<dependency id="TqkLibrary.FFmpeg.Gpl2.Native.Win.x64" version="9.0.2" />
				<dependency id="TqkLibrary.FFmpeg.Gpl2.Native.Win.arm64" version="9.0.2" />
				<dependency id="TqkLibrary.FFmpeg.Gpl2.Native.Linux.x64" version="9.0.2" />
				<dependency id="TqkLibrary.FFmpeg.Gpl2.Native.Linux.arm64" version="9.0.2" />
			</group>
		</dependencies>
	</metadata>

	<files>
		<file src="bin\Release\net462\TqkLibrary.AudioPlayer.FFmpegAudioReader.dll" target="lib\net462\" />
		<file src="bin\Release\net462\TqkLibrary.AudioPlayer.FFmpegAudioReader.pdb" target="lib\net462\" />
		<file src="bin\Release\net462\TqkLibrary.AudioPlayer.FFmpegAudioReader.xml" target="lib\net462\" />

		<file src="bin\Release\net8.0\TqkLibrary.AudioPlayer.FFmpegAudioReader.dll" target="lib\net8.0\" />
		<file src="bin\Release\net8.0\TqkLibrary.AudioPlayer.FFmpegAudioReader.pdb" target="lib\net8.0\" />
		<file src="bin\Release\net8.0\TqkLibrary.AudioPlayer.FFmpegAudioReader.xml" target="lib\net8.0\" />

		<!-- Native wrapper built by CMake for every RID. -->
		<file src="..\native-artifacts\runtimes\**" target="runtimes\" />

		<file src="TqkLibrary.AudioPlayer.FFmpegAudioReader.props" target="build\" />
		<file src="TqkLibrary.AudioPlayer.FFmpegAudioReader.targets" target="build\" />

		<file src="..\..\README.md" target="docs\" />
	</files>
</package>
